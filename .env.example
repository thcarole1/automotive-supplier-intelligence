# Copiez ce fichier vers .env et renseignez les valeurs.
# .env est exclu de Git (voir .gitignore) : ne jamais y mettre de vrai secret ici.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=asip
POSTGRES_USER=asip_user
POSTGRES_PASSWORD=changeme

# Base de métadonnées Airflow (séparée de la base métier ci-dessus)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme
AIRFLOW_DB_NAME=airflow

# Clé de chiffrement Airflow (générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=

# Identifiants de l'interface web Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
